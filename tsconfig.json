{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [".opencode/tools/**/*.ts", "vite.config.ts", "playwright.config.ts", "tests/browser/**/*.ts"]
}
