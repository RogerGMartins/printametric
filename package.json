    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "occt-import-js": "0.0.23",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "replicad": "1.2.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.187.0"
  }
