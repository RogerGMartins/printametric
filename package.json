  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:app && vite build",
    "preview": "vite preview",
    "check": "node scripts/run-check.mjs",
    "check:awake": "node scripts/check-awake.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --project tsconfig.app.json"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@playwright/test": "1.64.1",
