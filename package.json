  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:app && vite build",
    "preview": "vite preview",
    "check": "node scripts/run-check.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --project tsconfig.app.json"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
